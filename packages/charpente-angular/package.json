{
  "name": "charpente-angular",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Angular wrapper for charpente: a standalone [charpente] directive that turns any element into a pure CSS skeleton while loading.",
  "keywords": [
    "angular",
    "skeleton",
    "skeleton-loader",
    "loading",
    "charpente"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/charpente.git",
    "directory": "packages/charpente-angular"
  },
  "homepage": "https://techmefr.github.io/charpente/",
  "bugs": "https://github.com/techmefr/charpente/issues",
  "type": "module",
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@angular/core": ">=19",
    "charpente": "*"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.2",
    "@analogjs/vitest-angular": "^2.9.2",
    "@angular/build": "^22.2.4",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.2.3",
    "charpente": "workspace:*",
    "jsdom": "^30.1.3",
    "rxjs": "^7.8.0"
  }
}
