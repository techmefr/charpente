{
  "name": "charpente-studio",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Theme generator for charpente: choose shapes, borders, paint, motion and hover with a live preview, then copy or save the theme.ts file.",
  "keywords": [
    "charpente",
    "skeleton",
    "theme",
    "editor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/charpente.git",
    "directory": "packages/charpente-studio"
  },
  "homepage": "https://techmefr.github.io/charpente/",
  "bugs": "https://github.com/techmefr/charpente/issues",
  "type": "module",
  "bin": {
    "charpente-studio": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "charpente": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    "./generator": {
      "types": "./dist/generator.d.ts",
      "import": "./dist/generator.js"
    }
  }
}
