{
  "name": "charpente-react",
  "version": "0.0.0",
  "license": "MIT",
  "description": "React wrapper for charpente: a Charpente component that turns its children into a pure CSS skeleton while loading.",
  "keywords": ["react", "skeleton", "skeleton-loader", "loading", "charpente", "nextjs"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/charpente.git",
    "directory": "packages/charpente-react"
  },
  "homepage": "https://techmefr.github.io/charpente/",
  "bugs": "https://github.com/techmefr/charpente/issues",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "charpente": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
