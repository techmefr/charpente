{
  "name": "charpente-vue",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Vue wrapper for charpente: a Charpente component that turns any slot into a pure CSS skeleton while loading.",
  "keywords": [
    "vue",
    "vue3",
    "skeleton",
    "skeleton-loader",
    "loading",
    "charpente",
    "nuxt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/charpente.git",
    "directory": "packages/charpente-vue"
  },
  "homepage": "https://techmefr.github.io/charpente/",
  "bugs": "https://github.com/techmefr/charpente/issues",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external vue",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "devDependencies": {
    "vue": ">=3.4"
  }
}
