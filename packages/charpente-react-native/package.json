{
  "name": "charpente-react-native",
  "version": "0.1.0",
  "license": "MIT",
  "description": "React Native wrapper for charpente: a Charpente container and skeleton-aware Text, Image, Pressable and Block that follow your charpente theme colors and radius.",
  "keywords": [
    "react-native",
    "skeleton",
    "skeleton-loader",
    "loading",
    "charpente"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/charpente.git",
    "directory": "packages/charpente-react-native"
  },
  "homepage": "https://techmefr.github.io/charpente/",
  "bugs": "https://github.com/techmefr/charpente/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "charpente": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
