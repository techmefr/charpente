{
  "name": "charpente",
  "version": "0.0.0",
  "description": "Skeleton loaders en CSS pur, thèmes, motions et timing configurables",
  "type": "module",
  "files": ["dist"],
  "bin": {
    "charpente": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/vite.ts src/cli.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jiti": "^2.4.2"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
