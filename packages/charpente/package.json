{
  "name": "charpente",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Pure CSS skeleton loaders with no runtime JS. DOM detection in CSS, plus 35 themes, motions and timing configured in one file, with dark mode and date-based seasonal theming.",
  "keywords": [
    "skeleton",
    "skeleton-loader",
    "loading",
    "placeholder",
    "shimmer",
    "css",
    "pure-css",
    "zero-js",
    "theming",
    "themes",
    "dark-mode",
    "seasonal",
    "vite-plugin",
    "framework-agnostic",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techmefr/charpente.git",
    "directory": "packages/charpente"
  },
  "homepage": "https://techmefr.github.io/charpente/",
  "bugs": "https://github.com/techmefr/charpente/issues",
  "type": "module",
  "files": ["dist"],
  "bin": {
    "charpente": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/dom.ts src/vite.ts src/cli.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jiti": "^2.4.2"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
