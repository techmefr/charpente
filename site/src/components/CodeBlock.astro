---
import { Code } from 'astro:components'

interface Props {
  code: string
  lang?: string
  title?: string
}

const { code, lang = 'ts', title } = Astro.props
---

<figure class="code">
  {title && <figcaption class="code__title">{title}</figcaption>}
  <Code
    code={code.replace(/^\n+|\s+$/g, '')}
    lang={lang as any}
    themes={{ light: 'github-light', dark: 'github-dark' }}
    defaultColor={false}
  />
</figure>
