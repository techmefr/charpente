---
import '../styles/glass.css'
import { avatar, photo } from '../lib/avatars'
import { palette } from '../lib/palette'
import { stateAttributes, type StateOptions } from '../lib/state'

interface Props extends StateOptions {
  class?: string
}

const { class: className, ...state } = Astro.props
---

<div class:list={['sample', className]} {...stateAttributes(state)}>
  <div class="sample__head">
    <img class="sample__avatar" width="44" height="44" alt="" src={avatar('CD', palette.teal)} />
    <div class="sample__who">
      <span class="sample__name">Camille Durand</span>
      <span class="sample__role">Project lead</span>
    </div>
  </div>
  <p class="sample__text">
    A short introduction spanning two or three lines, to show how text is painted line by line.
  </p>
  <img class="sample__photo" width="320" height="90" alt="" src={photo(palette.sky, palette.indigo)} />
  <div class="sample__row">
    <button type="button" class="ui-btn">Follow</button>
    <button type="button" class="ui-btn">Message</button>
  </div>
  <div class="sample__block" data-charpente-block>
    <svg viewBox="0 0 120 30" width="120" height="30" aria-hidden="true">
      <polyline points="0,25 20,18 40,22 60,8 80,14 100,4 120,10" fill="none" stroke="currentColor" stroke-width="2" />
    </svg>
  </div>
</div>

<style is:global>
  .sample {
    display: grid;
    gap: 0.6rem;
  }

  .sample__head {
    display: flex;
    gap: 0.65rem;
    align-items: center;
  }

  .sample__avatar {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
  }

  .sample__who {
    display: grid;
  }

  .sample__name {
    font-weight: 650;
  }

  .sample__role {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .sample__text {
    font-size: 0.9rem;
  }

  .sample__photo {
    width: 100%;
    height: 4rem;
    object-fit: cover;
  }

  .sample__row {
    display: flex;
    gap: 0.5rem;
  }

  .sample__block {
    height: 2.6rem;
    padding: 0.4rem;
    color: var(--accent);
  }

  .sample__block svg {
    width: 100%;
    height: 100%;
  }
</style>
