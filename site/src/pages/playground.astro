---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import PlaygroundControls from '../components/PlaygroundControls.astro'
import PlaygroundDashboard from '../components/PlaygroundDashboard.astro'
---

<StarlightPage
  frontmatter={{
    title: 'Playground',
    description: 'Choose the theme, motions, delay and offset, switch between light and dark and between loading and content, on a small dashboard.',
    tableOfContents: false,
  }}
>
  <p>
    Adjust the three axes on a dashboard-style page. This page's script only sets and removes
    attributes: all the rendering comes from charpente's CSS. Use the theme switcher in the header
    to toggle dark mode.
  </p>
  <div class="not-content cp">

    <div class="pg">
      <PlaygroundControls />

      <div class="pg__preview">
        <PlaygroundDashboard />
      </div>
    </div>
  </div>

  <script>
    import '../scripts/playground'
  </script>
</StarlightPage>
