---
import Base from '../layouts/Base.astro'
import { avatar, photo } from '../lib/avatars'
import { CUSTOM_THEMES, THEMES } from '../lib/site'
import { stateAttributes } from '../lib/state'

const motions = [
  { name: 'shimmer', checked: true },
  { name: 'pulse', checked: false },
  { name: 'wave', checked: false },
  { name: 'glitch', checked: false },
  { name: 'rebond', checked: false },
]

const kpis = [
  { label: 'Revenue', value: '$48,210', icon: 'circle' },
  { label: 'Orders', value: '1,204', icon: 'square' },
  { label: 'Average basket', value: '$40.05', icon: 'triangle' },
]

const orders = [
  ['1001', 'Lumière Workshop', '$1,240.00', 'Paid'],
  ['1002', 'Verdier House', '$389.90', 'Pending'],
  ['1003', 'Peony Studio', '$2,075.50', 'Paid'],
  ['1004', 'Harbor Café', '$96.00', 'Refunded'],
]

const products = [
  { name: 'Spiral notebook', note: 'Recycled paper', from: '#f59e0b', to: '#ef4444' },
  { name: 'Blue fountain pen', note: 'Fine nib', from: '#38bdf8', to: '#6366f1' },
  { name: 'Desk lamp', note: 'Warm LED', from: '#34d399', to: '#0ea5e9' },
]

const initial = stateAttributes({
  loading: true,
  theme: 'solid',
  motion: 'shimmer',
  delay: 120,
  stagger: 60,
})
---

<Base
  title="Playground"
  description="Choose the theme, motions, delay and offset, switch between light and dark and between loading and content, on a small dashboard."
>
  <div class="wide">
    <div class="prose">
      <h1>Playground</h1>
      <p class="lead">
        Adjust the three axes on a dashboard-style page. This page's script only
        sets and removes attributes: all the rendering comes from charpente's CSS.
      </p>
    </div>

    <div class="pg">
      <form class="pg__controls" aria-labelledby="pg-title" onsubmit="return false">
        <h2 id="pg-title" class="stage__label">Settings</h2>

        <label class="field">
          <span>Theme</span>
          <select id="pg-theme">
            <optgroup label="Built-in themes">
              {THEMES.map((theme) => <option value={theme.name}>{theme.label}</option>)}
            </optgroup>
            <optgroup label="This site's themes">
              {CUSTOM_THEMES.map((theme) => <option value={theme.name}>{theme.label}</option>)}
            </optgroup>
          </select>
        </label>

        <fieldset>
          <legend>Motions</legend>
          <ul class="checks" id="pg-motions">
            {
              motions.map((motion) => (
                <li>
                  <label>
                    <input type="checkbox" value={motion.name} checked={motion.checked} />
                    {motion.name}
                  </label>
                </li>
              ))
            }
          </ul>
        </fieldset>

        <label class="field">
          <span>Delay: <output id="pg-delay-out">120 ms</output></span>
          <input id="pg-delay" type="range" min="0" max="2000" step="10" value="120" />
        </label>

        <label class="field">
          <span>Stagger : <output id="pg-stagger-out">60 ms</output></span>
          <input id="pg-stagger" type="range" min="0" max="300" step="10" value="60" />
        </label>

        <div class="field">
          <span>Mode</span>
          <button type="button" class="btn btn--ghost" data-scheme-toggle aria-pressed="false">
            Dark mode
          </button>
        </div>

        <div class="field">
          <span>State</span>
          <button type="button" class="btn" id="pg-toggle">
            Show content
          </button>
        </div>

        <div class="field">
          <span>Applied attributes</span>
          <p class="pg__readout"><code id="pg-readout"></code></p>
        </div>
        <p class="sr-only" id="pg-status" role="status"></p>
      </form>

      <div class="pg__preview">
        <div
          class="mini"
          id="pg-root"
          data-testid="playground"
          {...initial}
        >
          <div class="mini__top">
            <h3>Dashboard</h3>
            <input type="search" placeholder="Search" aria-label="Search" />
            <button type="button" class="ui-btn">Export</button>
          </div>

          <section class="mini__kpis" aria-label="Indicators">
            {
              kpis.map((kpi) => (
                <article class="kpi">
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    {kpi.icon === 'circle' && <circle cx="10" cy="10" r="8" fill="currentColor" />}
                    {kpi.icon === 'square' && <rect x="2" y="2" width="16" height="16" fill="currentColor" />}
                    {kpi.icon === 'triangle' && <polygon points="10,2 18,18 2,18" fill="currentColor" />}
                  </svg>
                  <p class="kpi__label">{kpi.label}</p>
                  <strong class="kpi__value">{kpi.value}</strong>
                </article>
              ))
            }
          </section>

          <section class="panel">
            <h4>Sales over 12 months</h4>
            <svg class="chart" viewBox="0 0 600 140" role="img" aria-label="Sales curve" preserveAspectRatio="none">
              <polyline
                points="0,110 50,90 100,100 150,60 200,70 250,40 300,55 350,30 400,45 450,20 500,35 550,15 600,25"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
              />
            </svg>
          </section>

          <section class="panel">
            <h4>Recent orders</h4>
            <table class="orders">
              <thead>
                <tr><th scope="col">No.</th><th scope="col">Customer</th><th scope="col">Total</th><th scope="col">Status</th></tr>
              </thead>
              <tbody>
                {
                  orders.map((row) => (
                    <tr>
                      <td>{row[0]}</td>
                      <td>{row[1]}</td>
                      <td>{row[2]}</td>
                      <td><span class="badge">{row[3]}</span></td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </section>

          <section class="panel">
            <h4>Filters</h4>
            <form class="mini__form" onsubmit="return false">
              <label>Customer <input type="text" name="customer" placeholder="Customer name" /></label>
              <label>
                Status
                <select name="status">
                  <option>All</option>
                  <option>Paid</option>
                  <option>Pending</option>
                </select>
              </label>
              <label class="check"><input type="checkbox" name="late" /> Late only</label>
              <button type="submit" class="ui-btn">Apply</button>
            </form>
          </section>

          <section class="mini__cards" aria-label="Catalog">
            {
              products.map((product) => (
                <article class="mini__card">
                  <img width="320" height="120" alt="" src={photo(product.from, product.to)} />
                  <span class="lines__title">{product.name}</span>
                  <span class="lines__text">{product.note}</span>
                  <button type="button" class="ui-btn">Add</button>
                </article>
              ))
            }
          </section>
        </div>
      </div>
    </div>
  </div>

  <script>
    import '../scripts/playground'
  </script>
</Base>
