---
import CodeBlock from '../components/CodeBlock.astro'
import ProfileCard from '../components/ProfileCard.astro'
import Base from '../layouts/Base.astro'
import { href, NAV } from '../lib/site'
import { stateAttributes } from '../lib/state'

const links = NAV.filter((item) => item.path !== '')

const markup = `
<article data-charpente-loading aria-busy="true" inert>
  <img src="/avatar.png" alt="" width="54" height="54" />
  <div>
    <span>Camille Durand</span>
    <span>Project lead</span>
  </div>
  <button type="button">Follow</button>
</article>`

const config = `
import { defineCharpente } from 'charpente'

export default defineCharpente({
  defaultTheme: 'cyberpunk',
  motion: ['shimmer', 'glitch'],
  timing: { delay: 120, stagger: 40 },
  colorScheme: { dark: '[data-theme="dark"]' },
})`
---

<Base
  title="Home"
  description="charpente generates pure CSS skeleton loaders from a single configuration file: theme, motion and timing are three independent axes."
>
  <div class="hero">
    <h1>Pure CSS loading skeletons</h1>
    <p class="lead">
      You set an attribute on the area that is loading. <code>charpente</code> paints the text,
      images, buttons and blocks with the theme and animation of your choice, without a single
      line of runtime JavaScript.
    </p>
    <div class="cta">
      <a class="btn" href={href('getting-started')}>Get started</a>
      <a class="btn btn--ghost" href={href('playground')}>Open the playground</a>
    </div>
  </div>

  <section class="prose" aria-labelledby="demo-title">
    <h2 id="demo-title">The demo, for real</h2>
    <p>
      This card switches on its own between the loading state and the content. It is the same
      markup: only three attributes change.
    </p>
    <div class="split">
      <div class="stage">
        <div class="stage__bar">
          <span class="stage__label">Profile card</span>
          <button type="button" class="btn btn--ghost" data-loop-pause aria-pressed="false">
            Pause the loop
          </button>
        </div>
        <div
          class="demo-profile"
          data-loop
          data-loop-on="2800"
          data-loop-off="2400"
          data-loop-status="#demo-status"
          {...stateAttributes({ loading: true, theme: 'solid' })}
        >
          <ProfileCard loading={false} />
          <p class="lines__text">
            Camille has led the site redesign for three years. She likes projects where design
            and code move forward together.
          </p>
          <div class="chips">
            <span class="badge">12 projects</span>
            <span class="badge">Lyon</span>
            <span class="badge">Product team</span>
          </div>
        </div>
        <p id="demo-status" class="sr-only" role="status"></p>
      </div>
      <CodeBlock lang="html" title="What charpente expects" code={markup} />
    </div>
  </section>

  <section class="prose" aria-labelledby="axes-title">
    <h2 id="axes-title">Three independent axes</h2>
    <ul>
      <li>
        <strong>The theme</strong> says what a skeleton looks like: <code>solid</code>,
        <code>outline</code>, <code>dots</code>, <code>cyberpunk</code>, <code>web</code> and six
        seasonal themes.
      </li>
      <li>
        <strong>The motion</strong> says how it moves: <code>shimmer</code>, <code>pulse</code>,
        <code>wave</code>, <code>glitch</code>, alone or combined.
      </li>
      <li>
        <strong>The timing</strong> says when: a delay before appearing, to avoid flicker on
        fast loads, and an offset between elements.
      </li>
    </ul>
    <CodeBlock title="charpente.config.ts" code={config} />
  </section>

  <section class="prose" aria-labelledby="suite-title">
    <h2 id="suite-title">Explore the documentation</h2>
    <ul class="linkgrid">
      {
        links.map((item) => (
          <li>
            <a href={href(item.path)}>
              <strong>{item.label}</strong>
              <span>{item.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <script>
    import '../scripts/loop'
  </script>
</Base>

<style is:global>
  .demo-profile {
    display: grid;
    gap: 0.8rem;
  }
</style>
