---
import CodeBlock from '../components/CodeBlock.astro'
import Base from '../layouts/Base.astro'
import { href } from '../lib/site'
import astroConfig from '../../../examples/astro/astro.config.mjs?raw'
import astroLayout from '../../../examples/astro/src/layouts/Layout.astro?raw'
import astroPage from '../../../examples/astro/src/pages/simple.astro?raw'
import livewireApp from '../../../examples/livewire/resources/js/app.js?raw'
import livewireBlade from '../../../examples/livewire/resources/views/livewire/simple.blade.php?raw'
import livewireComponent from '../../../examples/livewire/app/Livewire/Simple.php?raw'
import livewireVite from '../../../examples/livewire/vite.config.js?raw'
import nextLayout from '../../../examples/next/app/layout.tsx?raw'
import nextPackage from '../../../examples/next/package.json'
import nextState from '../../../examples/next/app/_lib/state.ts?raw'
import nuxtConfig from '../../../examples/nuxt/nuxt.config.ts?raw'
import nuxtPage from '../../../examples/nuxt/app/pages/simple.vue?raw'
import reactFixture from '../../../examples/react/src/Fixture.tsx?raw'
import reactVite from '../../../examples/react/vite.config.ts?raw'
import svelteLayout from '../../../examples/svelte/src/routes/+layout.svelte?raw'
import svelteLoad from '../../../examples/svelte/src/routes/simple/+page.server.ts?raw'
import sveltePage from '../../../examples/svelte/src/routes/simple/+page.svelte?raw'
import svelteVite from '../../../examples/svelte/vite.config.ts?raw'
import vanillaFixture from '../../../examples/vanilla/src/fixture.js?raw'
import simpleHtml from '../../../fixtures/simple.html?raw'

const openingTag = (raw: string, marker: string): string => {
  const start = raw.indexOf(marker)
  const end = raw.indexOf('\n>', start)
  return raw.slice(start, end < 0 ? raw.indexOf('\n', start) : end + 2)
}

const throughLine = (raw: string, marker: string): string => {
  const at = raw.indexOf(marker)
  return raw.slice(0, raw.indexOf('\n', at))
}

const nextScripts = JSON.stringify({ scripts: nextPackage.scripts }, null, 2)
const nextConfig = `import { defineCharpente } from 'charpente'

export default defineCharpente({
  defaultTheme: 'solid',
  motion: 'shimmer',
  timing: { delay: 120, stagger: 40 },
})`

const sections = [
  { id: 'vite', label: 'Vite' },
  { id: 'nuxt', label: 'Nuxt and Vue' },
  { id: 'react', label: 'React' },
  { id: 'next', label: 'Next' },
  { id: 'sveltekit', label: 'SvelteKit' },
  { id: 'astro', label: 'Astro' },
  { id: 'livewire', label: 'Livewire and Laravel' },
  { id: 'html', label: 'Plain HTML' },
]

const install = `
pnpm add charpente
# or: npm install charpente / yarn add charpente`

const minimalConfig = `
import { defineCharpente } from 'charpente'

export default defineCharpente({
  defaultTheme: 'solid',
  motion: 'shimmer',
  timing: { delay: 120 },
})`

const minimalHtml = `
<section data-charpente-loading aria-busy="true" inert>
  <h2>Team</h2>
  <p>Four members</p>
  <img src="/photo.jpg" alt="Team photo" width="320" height="120" />
  <button type="button">Invite</button>
</section>`

const viteConfig = `
import { charpente } from 'charpente/vite'

export default { plugins: [charpente()] }`

const cssImport = `
import 'virtual:charpente.css'`

const themeModule = `
import { activeTheme } from 'virtual:charpente.theme'

document.documentElement.dataset.charpenteTheme = activeTheme()`

const cli = `
charpente build --config charpente.config.ts --out charpente.css
charpente theme --date 2026-10-31`

const vueWrapper = `
<script setup lang="ts">
import { Charpente } from 'charpente-vue'
</script>

<template>
  <Charpente :loading="pending" label="Loading the profile" :motion="['pulse', 'shimmer']" :delay="200">
    <UserCard :user="user ?? placeholder" />
  </Charpente>
</template>`

const vanillaHead = `
<link rel="stylesheet" href="/charpente.css" />`
---

<Base
  title="Getting started"
  description="Install charpente, set the loading attributes and wire the CSS into Vite, Nuxt, React, Next, SvelteKit, Astro, Livewire or plain HTML."
>
  <div class="prose">
    <h1>Getting started</h1>
    <p class="lead">
      Three steps: install the package, declare a theme, then mark the area that is loading.
    </p>

    <h2 id="installation">1. Install</h2>
    <CodeBlock lang="bash" code={install} />

    <h2 id="config">2. Declare the configuration</h2>
    <p>
      A <code>charpente.config.ts</code> file at the project root. Everything is optional: without
      configuration, you get the <code>solid</code> theme and the <code>shimmer</code> motion.
    </p>
    <CodeBlock title="charpente.config.ts" code={minimalConfig} />

    <h2 id="usage">3. Mark the area that is loading</h2>
    <p>Three attributes are enough, set together on the container:</p>
    <ul>
      <li>
        <code>data-charpente-loading</code> enables the skeleton on the whole subtree.
      </li>
      <li>
        <code>aria-busy="true"</code> tells screen readers that the area is being
        updated.
      </li>
      <li>
        <code>inert</code> takes the area out of keyboard navigation and the accessibility tree, so
        nobody can click a fake button.
      </li>
    </ul>
    <CodeBlock lang="html" code={minimalHtml} />
    <p>
      When the data arrives, remove the three attributes: the real content is already there, in
      the same place, with no layout shift.
    </p>

    <div class="table-wrap">
      <table class="ref">
        <caption>Recognized attributes and CSS variables</caption>
        <thead>
          <tr><th scope="col">Name</th><th scope="col">Where</th><th scope="col">Role</th></tr>
        </thead>
        <tbody>
          <tr><td><code>data-charpente-loading</code></td><td>container</td><td>Enables the skeleton.</td></tr>
          <tr><td><code>data-charpente-theme</code></td><td>container</td><td>Picks a theme, otherwise <code>defaultTheme</code>.</td></tr>
          <tr><td><code>data-charpente-motion</code></td><td>container</td><td>Names sorted alphabetically, separated by a space, or <code>none</code>.</td></tr>
          <tr><td><code>data-charpente-block</code></td><td>an element</td><td>Paints the element as a single block and hides its children.</td></tr>
          <tr><td><code>data-charpente-ready</code></td><td>container</td><td>Set for a few moments after loading for a fade-in.</td></tr>
          <tr><td><code>--charpente-delay</code></td><td>style</td><td>Delay before the skeleton appears, in <code>ms</code>.</td></tr>
          <tr><td><code>--charpente-stagger</code></td><td>style</td><td>Offset between siblings, in <code>ms</code>.</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="plugin">Vite plugin and CLI</h2>
    <p>
      The Vite plugin compiles the configuration on the fly and exposes two virtual modules. It
      re-reads the file on every change.
    </p>
    <CodeBlock title="vite.config.ts" code={viteConfig} />
    <CodeBlock title="main.ts" code={cssImport} />
    <p>
      <code>virtual:charpente.theme</code> gives today's theme according to the
      <a href={href('calendar')}>seasonal calendar</a>:
    </p>
    <CodeBlock code={themeModule} />
    <p>
      Without Vite, the <code>charpente build</code> command writes the CSS to a file. The
      <code>charpente theme</code> command prints the active theme for a date.
    </p>
    <CodeBlock lang="bash" code={cli} />

    <h2 id="integrations">Integrations</h2>
    <p>
      Each snippet below comes from the repository's <code>examples/</code> folder. The examples
      drive the loading state with <code>?state=loading</code> in the URL, for testing.
    </p>
    <ul class="subnav" aria-label="Integrations">
      {sections.map((section) => <li><a href={`#${section.id}`}>{section.label}</a></li>)}
    </ul>

    <section aria-labelledby="vite">
      <div class="prose">
        <h3 id="vite">Vite</h3>
        <p>
          Plug in the plugin, import the CSS once in the entry point, then set the
          attributes.
        </p>
        <CodeBlock title="vite.config.ts" code={viteConfig} />
        <CodeBlock title="examples/vanilla/src/fixture.js" lang="js" code={vanillaFixture} />
      </div>
    </section>

    <section aria-labelledby="nuxt">
      <div class="prose">
        <h3 id="nuxt">Nuxt and Vue</h3>
        <p>
          Add the plugin to <code>vite.plugins</code> and the virtual CSS to <code>css</code>.
        </p>
        <CodeBlock title="examples/nuxt/nuxt.config.ts" code={nuxtConfig} />
        <CodeBlock title="examples/nuxt/app/pages/simple.vue" lang="vue" code={nuxtPage} />
        <p>
          The <code>charpente-vue</code> package provides a <code>&lt;Charpente&gt;</code> component
          that sets the attributes, announces the loading state and handles the fade-out.
        </p>
        <CodeBlock lang="vue" code={vueWrapper} />
        <div class="table-wrap">
          <table class="ref">
            <caption>Props of &lt;Charpente&gt;</caption>
            <thead>
              <tr><th scope="col">Prop</th><th scope="col">Type</th><th scope="col">Default</th><th scope="col">Role</th></tr>
            </thead>
            <tbody>
              <tr><td><code>loading</code></td><td>boolean</td><td><code>false</code></td><td>Enables the skeleton, sets <code>aria-busy</code> and <code>inert</code>.</td></tr>
              <tr><td><code>tag</code></td><td>string</td><td><code>div</code></td><td>Root element rendered.</td></tr>
              <tr><td><code>theme</code></td><td>string</td><td>none</td><td>Local theme.</td></tr>
              <tr><td><code>motion</code></td><td>string or string[]</td><td>none</td><td>Local motions, sorted automatically.</td></tr>
              <tr><td><code>delay</code></td><td>number</td><td>none</td><td>Delay in ms.</td></tr>
              <tr><td><code>stagger</code></td><td>number</td><td>none</td><td>Offset in ms.</td></tr>
              <tr><td><code>label</code></td><td>string</td><td>empty</td><td>Text of a <code>role="status"</code> region read during loading.</td></tr>
              <tr><td><code>revealMs</code></td><td>number</td><td><code>260</code></td><td>Duration of <code>data-charpente-ready</code> after loading.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section aria-labelledby="react">
      <div class="prose">
        <h3 id="react">React</h3>
        <p>Same Vite plugin, then the attributes in JSX.</p>
        <CodeBlock title="examples/react/vite.config.ts" code={reactVite} />
        <CodeBlock title="examples/react/src/Fixture.tsx" lang="tsx" code={reactFixture} />
      </div>
    </section>

    <section aria-labelledby="next">
      <div class="prose">
        <h3 id="next">Next</h3>
        <p>
          Next does not use Vite: the CLI writes the CSS before startup and build, then the
          layout imports it.
        </p>
        <CodeBlock title="examples/next/package.json" lang="json" code={nextScripts} />
        <CodeBlock title="examples/next/charpente.config.ts" code={nextConfig} />
        <CodeBlock title="examples/next/app/layout.tsx" lang="tsx" code={nextLayout} />
        <CodeBlock title="examples/next/app/_lib/state.ts" code={nextState} />
      </div>
    </section>

    <section aria-labelledby="sveltekit">
      <div class="prose">
        <h3 id="sveltekit">SvelteKit</h3>
        <CodeBlock title="examples/svelte/vite.config.ts" code={svelteVite} />
        <CodeBlock title="examples/svelte/src/routes/+layout.svelte" lang="svelte" code={svelteLayout} />
        <CodeBlock title="examples/svelte/src/routes/simple/+page.server.ts" code={svelteLoad} />
        <CodeBlock
          title="examples/svelte/src/routes/simple/+page.svelte"
          lang="svelte"
          code={openingTag(sveltePage, '<main')}
        />
      </div>
    </section>

    <section aria-labelledby="astro">
      <div class="prose">
        <h3 id="astro">Astro</h3>
        <p>
          This site is itself built this way. The repository's example renders the page on the server, this
          site generates it statically: the plugin is identical.
        </p>
        <CodeBlock title="examples/astro/astro.config.mjs" lang="js" code={astroConfig} />
        <CodeBlock title="examples/astro/src/layouts/Layout.astro" lang="astro" code={astroLayout} />
        <CodeBlock
          title="examples/astro/src/pages/simple.astro"
          lang="astro"
          code={throughLine(astroPage, '<main')}
        />
      </div>
    </section>

    <section aria-labelledby="livewire">
      <div class="prose">
        <h3 id="livewire">Livewire and Laravel</h3>
        <p>
          The Vite plugin sits next to <code>laravel-vite-plugin</code>. The loading state
          comes from a component property, the Blade template sets the attributes.
        </p>
        <CodeBlock title="examples/livewire/vite.config.js" lang="js" code={livewireVite} />
        <CodeBlock title="examples/livewire/resources/js/app.js" lang="js" code={livewireApp} />
        <CodeBlock title="examples/livewire/app/Livewire/Simple.php" lang="php" code={livewireComponent} />
        <CodeBlock
          title="examples/livewire/resources/views/livewire/simple.blade.php"
          lang="blade"
          code={livewireBlade.split('\n')[0] ?? ''}
        />
      </div>
    </section>

    <section aria-labelledby="html">
      <div class="prose">
        <h3 id="html">Plain HTML</h3>
        <p>
          Without a bundler, generate the file with the CLI and link it. Here is the markup of the example
          page <code>fixtures/simple.html</code>.
        </p>
        <CodeBlock lang="bash" code="charpente build --out public/charpente.css" />
        <CodeBlock lang="html" code={vanillaHead} />
        <CodeBlock title="fixtures/simple.html" lang="html" code={simpleHtml.split('\n').slice(0, 12).join('\n') + '\n  ...'} />
      </div>
    </section>
  </div>
</Base>
