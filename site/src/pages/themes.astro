---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { Code } from '@astrojs/starlight/components'
import Sample from '../components/Sample.astro'
import { MOTIONS, THEMES } from '../lib/site'

const usage = `<section data-charpente-loading data-charpente-theme="cyberpunk" aria-busy="true" inert>
  ...
</section>`

const extra = `export default defineCharpente({
  defaultTheme: 'cyberpunk',
})`
---

<StarlightPage
  frontmatter={{
    title: 'Themes',
    description: 'The 35 charpente themes rendered with real elements: base, use cases, atlas, seasons and holidays.',
    tableOfContents: false,
  }}
>
  <p>
    A theme describes how to paint four families of elements: text, media, controls and blocks.
    Each card below is real markup in its loading state.
  </p>
  <p>
    Choose the theme of an area with <code>data-charpente-theme</code>, or of an entire site with
    <code>defaultTheme</code>. You can also <a href="/charpente/create-a-theme/">create your own</a>.
  </p>
  <Code lang="html" code={usage} />
  <Code lang="ts" title="charpente.config.ts" code={extra} />

  <div class="not-content cp">
    <div class="controls" role="group" aria-labelledby="gallery-controls">
      <h2 id="gallery-controls" class="sr-only">Gallery settings</h2>
      <label class="field">
        <span>Motion for the whole gallery</span>
        <select id="gallery-motion">
          <option value="">Site default (shimmer)</option>
          {MOTIONS.map((motion) => <option value={motion.name}>{motion.name}</option>)}
          <option value="pulse shimmer">pulse + shimmer</option>
          <option value="none">None (none)</option>
        </select>
      </label>
    </div>

    <ul class="themegrid" id="gallery">
      {
        THEMES.map((theme) => (
          <li class="themecard">
            <h3>
              {theme.label} <code>{theme.name}</code>
            </h3>
            <p>{theme.note}</p>
            <Sample theme={theme.name} />
          </li>
        ))
      }
    </ul>
  </div>

  <script>
    import '../scripts/gallery'
  </script>
</StarlightPage>
