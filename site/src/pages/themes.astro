---
import CodeBlock from '../components/CodeBlock.astro'
import Sample from '../components/Sample.astro'
import Base from '../layouts/Base.astro'
import { href, MOTIONS, THEMES } from '../lib/site'

const usage = `
<section data-charpente-loading data-charpente-theme="cyberpunk" aria-busy="true" inert>
  ...
</section>`

const extra = `
export default defineCharpente({
  defaultTheme: 'cyberpunk',
})`
---

<Base
  title="Themes"
  description="The 35 charpente themes rendered with real elements: base, use cases, atlas, seasons and holidays."
>
  <div class="wide">
    <div class="prose">
      <h1>Themes</h1>
      <p class="lead">
        A theme describes how to paint four families of elements: text, media, controls and
        blocks. Each card below is real markup in its loading state.
      </p>
      <p>
        Choose the theme of an area with <code>data-charpente-theme</code>, or of an entire site
        with <code>defaultTheme</code>. You can also{' '}
        <a href={href('create-a-theme')}>create your own</a>.
      </p>
      <CodeBlock lang="html" code={usage} />
      <CodeBlock title="charpente.config.ts" code={extra} />
    </div>

    <div class="controls" role="group" aria-labelledby="gallery-controls">
      <h2 id="gallery-controls" class="sr-only">Gallery settings</h2>
      <label class="field">
        <span>Motion for the whole gallery</span>
        <select id="gallery-motion">
          <option value="">Site default (shimmer)</option>
          {MOTIONS.map((motion) => <option value={motion.name}>{motion.name}</option>)}
          <option value="pulse shimmer">pulse + shimmer</option>
          <option value="none">None (none)</option>
        </select>
      </label>
      <div class="field">
        <span>Page background</span>
        <button type="button" class="btn btn--ghost" data-scheme-toggle aria-pressed="false">
          Dark mode
        </button>
      </div>
    </div>

    <ul class="themegrid" id="gallery">
      {
        THEMES.map((theme) => (
          <li class="themecard">
            <h3>
              {theme.label} <code>{theme.name}</code>
            </h3>
            <p>{theme.note}</p>
            <Sample theme={theme.name} />
          </li>
        ))
      }
    </ul>
  </div>

  <script>
    import '../scripts/gallery'
  </script>
</Base>
