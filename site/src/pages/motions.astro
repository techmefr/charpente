---
import CodeBlock from '../components/CodeBlock.astro'
import Sample from '../components/Sample.astro'
import Base from '../layouts/Base.astro'
import { href, MOTIONS } from '../lib/site'
import { stateAttributes } from '../lib/state'

const attributeExample = `
<div data-charpente-loading data-charpente-motion="pulse shimmer" aria-busy="true" inert>
  ...
</div>`

const timingExample = `
<div
  data-charpente-loading
  data-charpente-motion="wave"
  style="--charpente-delay: 600ms; --charpente-stagger: 150ms"
  aria-busy="true"
  inert
>
  ...
</div>`

const configExample = `
export default defineCharpente({
  motion: ['pulse', 'shimmer'],
  timing: { delay: 120, stagger: 40 },
})`

const combos = [
  {
    motion: 'pulse shimmer',
    title: 'pulse + shimmer',
    note: 'Compatible: the glint goes through a background layer, the breathing through opacity.',
  },
  {
    motion: 'glitch shimmer',
    title: 'glitch + shimmer',
    note: 'Compatible: a movement and a background layer do not interfere.',
  },
  {
    motion: 'pulse wave',
    title: 'pulse + wave (conflict)',
    note: 'Both animate opacity. Both animations are applied, the last one in the list wins, and the offset of wave disappears.',
  },
  {
    motion: 'shimmer pulse',
    title: 'shimmer pulse (badly sorted)',
    note: 'No rule matches this order: the skeleton stays frozen. Always sort the names alphabetically.',
  },
]

const delays = [0, 600, 1500]
const staggers = [0, 150]
---

<Base
  title="Motions and timing"
  description="Shimmer, pulse, wave and glitch: each motion rendered, the delay before appearing, the offset between elements, combinations and their conflicts."
>
  <div class="wide">
    <div class="prose">
      <h1>Motions and timing</h1>
      <p class="lead">
        The motion describes the movement, the timing describes the moment. Both are set
        independently of the theme.
      </p>
      <div class="cta">
        <button type="button" class="btn btn--ghost" data-loop-pause aria-pressed="false">
          Pause the loop
        </button>
      </div>
    </div>

    <section class="prose" aria-labelledby="motions-title">
      <h2 id="motions-title">The four motions</h2>
      <p>
        Each one is a CSS animation applied to every leaf of the area. Without an attribute,
        the motion from <code>motion</code> in the configuration applies.
      </p>
    </section>
    <ul class="motionlist">
      {
        MOTIONS.map((motion) => (
          <li class="themecard">
            <h3>
              {motion.name} <code>{`data-charpente-motion="${motion.name}"`}</code>
            </h3>
            <p>{motion.note}</p>
            <Sample motion={motion.name} />
          </li>
        ))
      }
    </ul>

    <section class="prose" aria-labelledby="combo-title">
      <h2 id="combo-title">Combining and conflicts</h2>
      <p>
        <code>data-charpente-motion</code> accepts several names separated by a space, <strong
          >sorted alphabetically</strong
        >. The compiler generates one rule per combination, up to six declared motions; beyond
        that, only single motions are generated.
      </p>
      <CodeBlock lang="html" code={attributeExample} />
      <p>
        Two motions that animate the same property conflict: the last one in the list
        wins. In the configuration, the compiler reports it with a warning; on an
        attribute, nothing is reported.
      </p>
      <CodeBlock title="charpente.config.ts" code={configExample} />
    </section>
    <ul class="combo">
      {
        combos.map((combo) => (
          <li class="themecard">
            <h3>
              {combo.title}
            </h3>
            <p>{combo.note}</p>
            <Sample motion={combo.motion} />
            <p>
              <code>{`data-charpente-motion="${combo.motion}"`}</code>
            </p>
          </li>
        ))
      }
    </ul>

    <section class="prose" aria-labelledby="delay-title">
      <h2 id="delay-title">The delay</h2>
      <p>
        <code>delay</code> postpones the appearance of the skeleton. In the meantime, the elements are
        hidden: a load shorter than the delay causes no flicker. Global setting
        in <code>timing.delay</code>, local setting with <code>--charpente-delay</code>.
      </p>
    </section>
    <ul class="combo">
      {
        delays.map((delay) => (
          <li class="themecard">
            <h3>
              Delay <code>{`${delay} ms`}</code>
            </h3>
            <div
              class="lines"
              data-loop
              data-loop-on="4200"
              data-loop-off="1400"
              {...stateAttributes({ loading: true, delay, motion: 'pulse' })}
            >
              <span class="lines__title">Card title</span>
              <p class="lines__text">
                A text spanning two lines to judge how the skeleton appears.
              </p>
              <button type="button" class="ui-btn">Action</button>
            </div>
          </li>
        ))
      }
    </ul>

    <section class="prose" aria-labelledby="stagger-title">
      <h2 id="stagger-title">The offset between elements</h2>
      <p>
        <code>stagger</code> adds a delay proportional to the position of each element among
        its siblings (from 1 to 16): the skeleton appears in a cascade, and the <code>wave</code>
        motion ripples from one element to the next. Global setting in <code>timing.stagger</code>, local with
        <code>--charpente-stagger</code>.
      </p>
      <CodeBlock lang="html" code={timingExample} />
    </section>
    <ul class="combo">
      {
        staggers.map((stagger) => (
          <li class="themecard">
            <h3>
              Stagger <code>{`${stagger} ms`}</code>
            </h3>
            <div
              class="bars"
              data-loop
              data-loop-on="4200"
              data-loop-off="1400"
              {...stateAttributes({ loading: true, delay: 0, stagger, motion: 'wave' })}
            >
              {Array.from({ length: 8 }, () => <div class="bar" />)}
            </div>
          </li>
        ))
      }
    </ul>

    <div class="prose">
      <p class="note">
        <span>Reduced motion</span><br />
        If the system asks for less animation (<code>prefers-reduced-motion</code>), all
        motions and the delay are disabled: the skeleton shows immediately, static. See the
        <a href={href('accessibility')}>Accessibility</a> page.
      </p>
    </div>
  </div>

  <script>
    import '../scripts/loop'
  </script>
</Base>
