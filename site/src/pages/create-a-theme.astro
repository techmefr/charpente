---
import CodeBlock from '../components/CodeBlock.astro'
import Sample from '../components/Sample.astro'
import Base from '../layouts/Base.astro'
import { href } from '../lib/site'

const step1 = `
import { defineCharpente } from 'charpente'

export default defineCharpente({
  themes: {
    brume: {
      extends: 'solid',
      tokens: {
        base: 'rgba(96, 165, 250, 0.3)',
        strong: 'rgba(59, 130, 246, 0.55)',
        shine: 'rgba(255, 255, 255, 0.6)',
      },
    },
  },
})`

const step2 = `
themes: {
  'brume-ronde': {
    extends: 'brume',
    paint: {
      media: { style: { borderRadius: '50%' } },
      control: { style: { borderRadius: '999px' } },
      block: {
        fill: 'repeating-linear-gradient(45deg, var(--charpente-base) 0 10px, var(--charpente-strong) 10px 20px)',
      },
    },
  },
}`

const step3 = `
motions: {
  rebond: {
    duration: '1.2s',
    staggered: true,
    keyframes: {
      '0%, 100%': { transform: 'translateY(0)' },
      '50%': { transform: 'translateY(-3px)' },
    },
  },
}`

const markup3 = `
<div
  data-charpente-loading
  data-charpente-theme="brume-ronde"
  data-charpente-motion="rebond"
  aria-busy="true"
  inert
>
  ...
</div>`

const step4 = `
export default defineCharpente({
  defaultTheme: 'brume-ronde',
  motion: 'rebond',
})`
---

<Base
  title="Create a theme"
  description="Step-by-step tutorial: start from an existing theme with extends, change the tokens, add a paint, write a motion and see the result live."
>
  <div class="wide">
    <div class="prose">
      <h1>Create a theme</h1>
      <p class="lead">
        We start from <code>solid</code>, change the colors, add a paint, then a
        motion. Each step is rendered next to its code, with the real CSS generated from this
        site's configuration file.
      </p>
      <p>
        The principle: a theme only needs to describe what changes.
        <code>extends</code> inherits the rest. The options are detailed in the
        <a href={href('configuration')}>reference</a>.
      </p>
    </div>

    <ol class="steps">
      <li>
        <h3>Recolor with tokens</h3>
        <div class="prose">
          <p>
            The shortest theme: it extends <code>solid</code> and only changes its tokens.
            The colors are semi-transparent to stay readable in both light and dark.
          </p>
        </div>
        <div class="split">
          <CodeBlock title="charpente.config.ts" code={step1} />
          <div class="stage">
            <div class="stage__bar"><span class="stage__label">Theme brume</span></div>
            <Sample theme="brume" />
          </div>
        </div>
      </li>

      <li>
        <h3>Add a paint</h3>
        <div class="prose">
          <p>
            A second theme extends the first and redefines the paint of three leaf types.
            Only the given fields are replaced: here, the radius of media and controls and the
            background of blocks.
          </p>
        </div>
        <div class="split">
          <CodeBlock title="charpente.config.ts" code={step2} />
          <div class="stage">
            <div class="stage__bar"><span class="stage__label">Theme brume-ronde</span></div>
            <Sample theme="brume-ronde" />
          </div>
        </div>
      </li>

      <li>
        <h3>Write a motion</h3>
        <div class="prose">
          <p>
            A motion is a CSS animation applied to every leaf. With
            <code>staggered</code>, it starts in a cascade according to the site's <code>stagger</code>.
            The animated properties are free.
          </p>
        </div>
        <div class="split">
          <div class="prose">
            <CodeBlock title="charpente.config.ts" code={step3} />
            <CodeBlock lang="html" code={markup3} />
          </div>
          <div class="stage">
            <div class="stage__bar"><span class="stage__label">brume-ronde + rebond</span></div>
            <Sample theme="brume-ronde" motion="rebond" />
          </div>
        </div>
      </li>

      <li>
        <h3>Enable it everywhere</h3>
        <div class="prose">
          <p>
            Make it the default theme, or assign it to a period of the year with the
            <a href={href('calendar')}>seasonal calendar</a>.
          </p>
          <CodeBlock title="charpente.config.ts" code={step4} />
          <p class="note">
            <span>Tip</span><br />
            You can try these themes in the <a href={href('playground')}>playground</a>,
            where <code>brume</code> and <code>brume-ronde</code> are offered in the list.
          </p>
        </div>
      </li>
    </ol>
  </div>
</Base>
