---
import { themeAt } from 'charpente'
import CodeBlock from '../components/CodeBlock.astro'
import Sample from '../components/Sample.astro'
import Base from '../layouts/Base.astro'
import config from '../../charpente.config'

const entries = config.schedule ?? []
const sampleDates = ['2026-03-01', '2026-10-31', '2026-12-25', '2026-06-15']
const transcripts = sampleDates
  .map((date) => `$ charpente theme --date ${date}\n${themeAt(config, new Date(`${date}T12:00:00Z`))}`)
  .join('\n\n')

const scheduleExample = `
import { defineCharpente } from 'charpente'

export default defineCharpente({
  defaultTheme: 'solid',
  timeZone: 'Europe/Paris',
  schedule: [
    { theme: 'halloween', from: '10-24', to: '11-02' },
    { theme: 'christmas', from: '12-15', to: '12-31' },
    { theme: 'winter', from: '12-01', to: '02-15' },
  ],
})`

const themeAtExample = `
import { themeAt } from 'charpente'
import config from './charpente.config'

themeAt(config, new Date('2026-10-31T12:00:00Z'))
themeAt(config)`

const virtualExample = `
import { activeTheme } from 'virtual:charpente.theme'

const root = document.documentElement
root.dataset.charpenteTheme = activeTheme()
root.dataset.charpenteTheme = activeTheme(new Date('2026-12-25T12:00:00Z'))`

const typesExample = `
declare module 'virtual:charpente.theme' {
  export const activeTheme: (date?: Date) => string
}`
---

<Base
  title="Seasonal calendar"
  description="Automatically choose a theme by date with schedule, themeAt, the virtual:charpente.theme virtual module and the charpente theme command."
>
  <div class="wide">
    <div class="prose">
      <h1>Seasonal calendar</h1>
      <p class="lead">
        <code>schedule</code> maps periods of the year to themes. Halloween in October,
        Christmas in December, and the default theme the rest of the time.
      </p>

      <h2 id="schedule">Declaring the slots</h2>
      <p>
        Each slot has a <code>theme</code>, a start date <code>from</code> and an end date
        <code>to</code>, in <code>MM-DD</code> format, bounds included. The <strong>first
        matching slot wins</strong>. If <code>to</code> comes before <code>from</code>, the
        slot spans New Year (<code>12-01</code> to <code>02-15</code>). With no match,
        <code>defaultTheme</code> applies.
      </p>
      <p>
        The date is read in <code>timeZone</code> (for example <code>Europe/Paris</code>), not in
        the visitor's, so the theme changes at the same instant for everyone.
      </p>
      <CodeBlock title="charpente.config.ts" code={scheduleExample} />
      <p class="warn">
        <span>Slot order</span><br />
        In the example, <code>winter</code> is declared after <code>christmas</code>: from December 15 to 31,
        <code>christmas</code> wins, as expected.
      </p>

      <h2 id="site">This site's calendar</h2>
      <div class="table-wrap">
        <table class="ref">
          <caption>schedule from site/charpente.config.ts</caption>
          <thead>
            <tr><th scope="col">Theme</th><th scope="col">From</th><th scope="col">To</th></tr>
          </thead>
          <tbody>
            {entries.map((entry) => <tr><td><code>{entry.theme}</code></td><td>{entry.from}</td><td>{entry.to}</td></tr>)}
            <tr><td><code>{config.defaultTheme}</code></td><td colspan="2">the rest of the year (<code>defaultTheme</code>)</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <section class="stage" aria-labelledby="calc-title">
      <div class="stage__bar">
        <h2 id="calc-title" class="stage__label">Which theme on that day?</h2>
      </div>
      <div class="split">
        <div class="pg__controls">
          <label class="field">
            <span>Date</span>
            <input type="date" id="calendar-date" />
          </label>
          <p>
            Active theme: <strong id="calendar-theme" aria-live="polite">solid</strong>
          </p>
          <p class="pg__readout"><code id="calendar-call">activeTheme()</code></p>
        </div>
        <div id="calendar-sample">
          <Sample theme="solid" />
        </div>
      </div>
    </section>

    <div class="prose">
      <h2 id="theme-at">themeAt</h2>
      <p>
        <code>themeAt(config, date)</code> is the pure function behind everything else. The date defaults to
        "now" when omitted.
      </p>
      <CodeBlock code={themeAtExample} />

      <h2 id="virtual">virtual:charpente.theme</h2>
      <p>
        The Vite plugin provides a virtual module with <code>defaultTheme</code>,
        <code>timeZone</code> and <code>schedule</code> already bundled. It exports
        <code>activeTheme(date?)</code>.
      </p>
      <CodeBlock code={virtualExample} />
      <p>For TypeScript, declare the module in an <code>env.d.ts</code> file:</p>
      <CodeBlock code={typesExample} />

      <h2 id="cli">charpente theme --date</h2>
      <p>
        The command prints the active theme, useful in a deploy script or to check a
        calendar. Without <code>--date</code>, it uses today. Here are the results for this
        site's configuration:
      </p>
      <CodeBlock lang="bash" code={transcripts} />
    </div>
  </div>

  <script>
    import '../scripts/calendar'
  </script>
</Base>
