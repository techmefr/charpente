---
import Base from '../layouts/Base.astro'
import { avatar, photo } from '../lib/avatars'
import { CUSTOM_THEMES, THEMES } from '../lib/site'
import { stateAttributes } from '../lib/state'

const motions = [
  { name: 'shimmer', checked: true },
  { name: 'pulse', checked: false },
  { name: 'wave', checked: false },
  { name: 'glitch', checked: false },
  { name: 'rebond', checked: false },
]

const kpis = [
  { label: 'Chiffre d’affaires', value: '48 210 €', icon: 'circle' },
  { label: 'Commandes', value: '1 204', icon: 'square' },
  { label: 'Panier moyen', value: '40,05 €', icon: 'triangle' },
]

const orders = [
  ['1001', 'Atelier Lumière', '1 240,00 €', 'Payée'],
  ['1002', 'Maison Verdier', '389,90 €', 'En cours'],
  ['1003', 'Studio Pivoine', '2 075,50 €', 'Payée'],
  ['1004', 'Café du Port', '96,00 €', 'Remboursée'],
]

const products = [
  { name: 'Carnet à spirale', note: 'Papier recyclé', from: '#f59e0b', to: '#ef4444' },
  { name: 'Stylo plume bleu', note: 'Plume fine', from: '#38bdf8', to: '#6366f1' },
  { name: 'Lampe de bureau', note: 'LED chaude', from: '#34d399', to: '#0ea5e9' },
]

const initial = stateAttributes({
  loading: true,
  theme: 'solid',
  motion: 'shimmer',
  delay: 120,
  stagger: 60,
})
---

<Base
  title="Terrain de jeu"
  description="Choisissez le thème, les motions, le délai et le décalage, basculez entre clair et sombre et entre chargement et contenu, sur un tableau de bord réduit."
>
  <div class="wide">
    <div class="prose">
      <h1>Terrain de jeu</h1>
      <p class="lead">
        Réglez les trois axes sur une page type tableau de bord. Le script de cette page ne fait
        que poser et retirer des attributs : tout le rendu vient du CSS de charpente.
      </p>
    </div>

    <div class="pg">
      <form class="pg__controls" aria-labelledby="pg-title" onsubmit="return false">
        <h2 id="pg-title" class="stage__label">Réglages</h2>

        <label class="field">
          <span>Thème</span>
          <select id="pg-theme">
            <optgroup label="Thèmes fournis">
              {THEMES.map((theme) => <option value={theme.name}>{theme.label}</option>)}
            </optgroup>
            <optgroup label="Thèmes de ce site">
              {CUSTOM_THEMES.map((theme) => <option value={theme.name}>{theme.label}</option>)}
            </optgroup>
          </select>
        </label>

        <fieldset>
          <legend>Motions</legend>
          <ul class="checks" id="pg-motions">
            {
              motions.map((motion) => (
                <li>
                  <label>
                    <input type="checkbox" value={motion.name} checked={motion.checked} />
                    {motion.name}
                  </label>
                </li>
              ))
            }
          </ul>
        </fieldset>

        <label class="field">
          <span>Délai : <output id="pg-delay-out">120 ms</output></span>
          <input id="pg-delay" type="range" min="0" max="2000" step="10" value="120" />
        </label>

        <label class="field">
          <span>Stagger : <output id="pg-stagger-out">60 ms</output></span>
          <input id="pg-stagger" type="range" min="0" max="300" step="10" value="60" />
        </label>

        <div class="field">
          <span>Mode</span>
          <button type="button" class="btn btn--ghost" data-scheme-toggle aria-pressed="false">
            Mode sombre
          </button>
        </div>

        <div class="field">
          <span>État</span>
          <button type="button" class="btn" id="pg-toggle">
            Afficher le contenu
          </button>
        </div>

        <div class="field">
          <span>Attributs posés</span>
          <p class="pg__readout"><code id="pg-readout"></code></p>
        </div>
        <p class="sr-only" id="pg-status" role="status"></p>
      </form>

      <div class="pg__preview">
        <div
          class="mini"
          id="pg-root"
          data-testid="playground"
          {...initial}
        >
          <div class="mini__top">
            <h3>Tableau de bord</h3>
            <input type="search" placeholder="Rechercher" aria-label="Rechercher" />
            <button type="button" class="ui-btn">Exporter</button>
          </div>

          <section class="mini__kpis" aria-label="Indicateurs">
            {
              kpis.map((kpi) => (
                <article class="kpi">
                  <svg viewBox="0 0 20 20" aria-hidden="true">
                    {kpi.icon === 'circle' && <circle cx="10" cy="10" r="8" fill="currentColor" />}
                    {kpi.icon === 'square' && <rect x="2" y="2" width="16" height="16" fill="currentColor" />}
                    {kpi.icon === 'triangle' && <polygon points="10,2 18,18 2,18" fill="currentColor" />}
                  </svg>
                  <p class="kpi__label">{kpi.label}</p>
                  <strong class="kpi__value">{kpi.value}</strong>
                </article>
              ))
            }
          </section>

          <section class="panel">
            <h4>Ventes sur 12 mois</h4>
            <svg class="chart" viewBox="0 0 600 140" role="img" aria-label="Courbe des ventes" preserveAspectRatio="none">
              <polyline
                points="0,110 50,90 100,100 150,60 200,70 250,40 300,55 350,30 400,45 450,20 500,35 550,15 600,25"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
              />
            </svg>
          </section>

          <section class="panel">
            <h4>Commandes récentes</h4>
            <table class="orders">
              <thead>
                <tr><th scope="col">N°</th><th scope="col">Client</th><th scope="col">Total</th><th scope="col">Statut</th></tr>
              </thead>
              <tbody>
                {
                  orders.map((row) => (
                    <tr>
                      <td>{row[0]}</td>
                      <td>{row[1]}</td>
                      <td>{row[2]}</td>
                      <td><span class="badge">{row[3]}</span></td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </section>

          <section class="panel">
            <h4>Filtres</h4>
            <form class="mini__form" onsubmit="return false">
              <label>Client <input type="text" name="customer" placeholder="Nom du client" /></label>
              <label>
                Statut
                <select name="status">
                  <option>Tous</option>
                  <option>Payée</option>
                  <option>En cours</option>
                </select>
              </label>
              <label class="check"><input type="checkbox" name="late" /> Retards seulement</label>
              <button type="submit" class="ui-btn">Appliquer</button>
            </form>
          </section>

          <section class="mini__cards" aria-label="Catalogue">
            {
              products.map((product) => (
                <article class="mini__card">
                  <img width="320" height="120" alt="" src={photo(product.from, product.to)} />
                  <span class="lines__title">{product.name}</span>
                  <span class="lines__text">{product.note}</span>
                  <button type="button" class="ui-btn">Ajouter</button>
                </article>
              ))
            }
          </section>
        </div>
      </div>
    </div>
  </div>

  <script>
    import '../scripts/playground'
  </script>
</Base>
